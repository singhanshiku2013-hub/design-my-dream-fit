# Chic Canvas — AI Stylist configuration
#
# The stylist server function needs exactly ONE provider key. They are checked
# in this order: OpenAI → Anthropic → Lovable AI Gateway.

# --- Option 1: OpenAI (default recommendation) ---
OPENAI_API_KEY=sk-...
# Optional override, defaults to gpt-4o-mini
# OPENAI_MODEL=gpt-4o-mini

# --- Option 2: Anthropic ---
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-4-5

# --- Option 3: Lovable AI Gateway (auto-injected when hosted on Lovable) ---
# LOVABLE_API_KEY=
# LOVABLE_MODEL=google/gemini-3.6-flash
